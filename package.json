{
  "name": "monely-finance",
  "private": true,
  "version": "1.0.0",
  "description": "Monely Finance - Seu dinheiro, claro e organizado.",
  "author": "Monely Finance",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run server\"",
    "server": "python python/server.py",
    "build": "vite build",
    "build:backend": "python -m PyInstaller --noconfirm --onefile --name monely-server --paths python --distpath electron/backend-dist --workpath electron/build-tmp --specpath electron --exclude-module pandas --exclude-module numpy --exclude-module yfinance --exclude-module supabase --exclude-module ofxparse --exclude-module pypdf --exclude-module openpyxl --exclude-module pdfplumber --exclude-module tabulate --exclude-module langchain --exclude-module langchain_openai --exclude-module langchain_experimental --exclude-module langchain_core --exclude-module langchain_community --exclude-module tiktoken --exclude-module bank_import_service --exclude-module sync_investments --exclude-module processador_extrato --exclude-module import_transactions --exclude-module validate_rules python/server.py",
    "electron:dev": "electron electron/main.cjs",
    "dist:win": "npm run build && electron-builder --win",
    "release": "node scripts/release.js",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose",
    "generate-icons": "capacitor-assets generate --android"
  },
  "build": {
    "appId": "com.monelyfinance.app",
    "productName": "Monely Finance",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/backend-dist/monely-server.exe",
        "to": "backend/monely-server.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Monely Finance"
    }
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^7.0.0",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.1",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.6",
    "@capacitor/local-notifications": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.4",
    "@supabase/supabase-js": "^2.83.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "openai": "^6.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "6.22.3",
    "recharts": "2.12.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "supabase": "^2.67.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.5",
    "workbox-window": "^7.4.1"
  }
}
